# ===== توكنات البوتات الأربعة (كل بوت توكنه) - تحطها في Environment Variables بـ Render =====
TOKEN=توكن_بوت_التمب_فويس
TESTME_TOKEN=توكن_بوت_Test_me
UNO_TOKEN=توكن_بوت_Uno
EVENT_TOKEN=توكن_بوت_الفعاليات

# ===== إعدادات التمب فويس (نفس القديمة) =====
CREATE_CHANNEL_ID=آيدي_روم_اضغط_لإنشاء_روم
LOG_CHANNEL_ID=آيدي_روم_اللوج
CATEGORY_ID=
GUILD_ID=

# ===== اختيارية (نفس القديمة لبقية البوتات، لو كنت تستخدمها) =====
# OWNER_ID  (Test me)
# STOP_ROLE_IDS / STOP_USER_IDS / UNO_CHANNEL_ID / STORAGE_CHANNEL_ID  (Uno)
# DB_PATH  (الفعاليات)

# ================= بوتات حماية القذف الصوتية (حتى 5 نسخ) =================
# تشتغل في عملية منفصلة ما تشوف إلا متغيرات GUARD_*.
# كل نسخة = بوت ديسكورد مستقل (توكن) + روم صوتي واحد. أي نسخة ما تحط لها توكن تنتخطى.
GUARD_GUILD_ID=آيدي_السيرفر
GUARD_LOG_CHANNEL_ID=آيدي_روم_لوق_القذف
GUARD_STT_API_KEY=مفتاح_Groq            # مشترك بين النسخ (أو GUARD_STT_API_KEY_2 لنسخة لها مفتاح خاص)

GUARD_TOKEN_1=توكن_النسخة_1
GUARD_ROOM_1=آيدي_الروم_الصوتي_1
GUARD_TOKEN_2=
GUARD_ROOM_2=
GUARD_TOKEN_3=
GUARD_ROOM_3=
GUARD_TOKEN_4=
GUARD_ROOM_4=
GUARD_TOKEN_5=
GUARD_ROOM_5=

# اختيارية:
# GUARD_TIMEOUT_MINUTES=10
# GUARD_TIMEZONE=Asia/Riyadh
# GUARD_EXEMPT_ROLE_IDS=123,456           رتب مستثناة (الأدمن مستثنى دائماً)
# GUARD_LOG_PING_ROLE_ID=123              رتبة تتمنشن مع @here في اللوق
# GUARD_ANNOUNCE_NOTICE=true              رسالة التنبيه في الروم عند دخول البوت
# GUARD_STT_MODEL=whisper-large-v3
# GUARD_STT_CONCURRENCY=3                 كم تحويل صوت بنفس الوقت لكل النسخ (حماية حد Groq)
# GUARD_MIN_LOGPROB=-1.0

